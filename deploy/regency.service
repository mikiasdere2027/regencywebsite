[Unit]
Description=Regency Valet Parking Services Next.js
After=network.target

[Service]
Type=simple
User=regency
Group=regency
WorkingDirectory=/srv/regency/current
EnvironmentFile=/srv/regency/shared/.env
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=3
StandardOutput=journal
StandardError=journal
SyslogIdentifier=regency
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
